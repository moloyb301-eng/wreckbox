<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A key in a widget drawer: chrome pill, monospace label (widgets can't use the app's dot-matrix font). -->
    <style name="WbKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/wb_pill</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FF2B2D33</item>
        <item name="android:textSize">10sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>

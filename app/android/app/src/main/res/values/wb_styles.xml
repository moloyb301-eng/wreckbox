<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rows of the presets list. -->
    <style name="WbRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <!-- A preset chip (the app's glass pill; white when selected). Its label is a bitmap in Urbanist. -->
    <style name="WbChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/wb_chip</item>
        <item name="android:scaleType">center</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <!-- A key in the options drawer (the app's glass pill). -->
    <style name="WbPill" parent="WbChip">
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- WreckBox widget: a Y2K player shell (smoked plastic, iridescent rim, LCD, round dial, hanging tabs, drawers) in
     the app's design language — its near-black glass, lilac / light-blue / peach gradient, Doto for the display and
     dot labels, Urbanist for text. Shell, LCD, dial and EQ are bitmaps drawn by PlayerWidget from the same dp grid
     as this file (Geo): 14 dp gutter, 124 dp dial, LCD 44–148, seek 158–164, tabs 176–204. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ═══ Body: 204 dp ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="204dp">

        <ImageView android:id="@+id/wb_body_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />

        <!-- LCD: 14 from the left, 44 from the top, 150 from the right (dial 124 + gap 12 + gutter 14), 104 tall -->
        <ImageView
            android:id="@+id/wb_lcd"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="170dp"
            android:contentDescription="Open WreckBox"
            android:scaleType="fitXY" />

        <!-- Clock (Doto, redrawn each second while playing): 8 inside the LCD -->
        <ImageView
            android:id="@+id/wb_clock"
            android:layout_width="116dp"
            android:layout_height="32dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="50dp"
            android:contentDescription="@null"
            android:scaleType="fitStart" />

        <!-- Spectrum: 8 frames the launcher flips through by itself (widgets can't animate otherwise), in time
             with the track's BPM. Top right inside the LCD: 10 from its right edge (150 + 10), 8 from its top. -->
        <ViewFlipper
            android:id="@+id/wb_spectrum"
            android:layout_width="62dp"
            android:layout_height="30dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="52dp"
            android:layout_marginEnd="180dp"
            android:autoStart="true"
            android:flipInterval="140">
            <ImageView android:id="@+id/wb_sf0" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
            <ImageView android:id="@+id/wb_sf1" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
            <ImageView android:id="@+id/wb_sf2" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
            <ImageView android:id="@+id/wb_sf3" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
            <ImageView android:id="@+id/wb_sf4" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
            <ImageView android:id="@+id/wb_sf5" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
            <ImageView android:id="@+id/wb_sf6" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
            <ImageView android:id="@+id/wb_sf7" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
        </ViewFlipper>

        <!-- Seek bar under the LCD, same left / right edges -->
        <ProgressBar
            android:id="@+id/wb_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="158dp"
            android:layout_marginEnd="170dp"
            android:max="1000"
            android:progressDrawable="@drawable/wb_seek" />

        <!-- Tabs hanging off the bottom edge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="14dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/wb_tab_eq" android:layout_width="104dp" android:layout_height="match_parent" android:background="@drawable/wb_tab_idle" android:contentDescription="Equaliser drawer" android:scaleType="center" />
            <ImageView android:id="@+id/wb_tab_controls" android:layout_width="92dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/wb_tab_idle" android:contentDescription="Options drawer" android:scaleType="center" />
        </LinearLayout>

        <!-- Dial: 124 × 124, 14 from the right, 44 from the top (level with the LCD). The ring is one bitmap; the
             buttons sit on its segments by gravity, so nothing can drift. -->
        <FrameLayout
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="22dp">

            <ImageView android:id="@+id/wb_dial" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />
            <ImageButton android:id="@+id/wb_volup" android:layout_width="50dp" android:layout_height="30dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="5dp" android:background="@drawable/wb_hit" android:contentDescription="Volume up" />
            <ImageButton android:id="@+id/wb_voldown" android:layout_width="50dp" android:layout_height="30dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="5dp" android:background="@drawable/wb_hit" android:contentDescription="Volume down" />
            <ImageButton android:id="@+id/wb_prev" android:layout_width="30dp" android:layout_height="50dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="5dp" android:background="@drawable/wb_hit" android:contentDescription="Previous" />
            <ImageButton android:id="@+id/wb_next" android:layout_width="30dp" android:layout_height="50dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="5dp" android:background="@drawable/wb_hit" android:contentDescription="Next" />
            <ImageButton android:id="@+id/wb_play" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:background="@drawable/wb_play" android:contentDescription="Play / pause" android:padding="17dp" android:scaleType="fitCenter" android:src="@drawable/wb_icb_play" />
        </FrameLayout>
    </FrameLayout>

    <!-- ═══ Equaliser drawer: 168 dp, inner area 14 / 8 / 14 / 18 ═══ -->
    <FrameLayout
        android:id="@+id/wb_drawer_eq"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:visibility="gone">

        <ImageView android:id="@+id/wb_drawer_eq_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/wb_eq_curve" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="11" android:contentDescription="@null" android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="10"
                android:background="@drawable/wb_card"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/wb_presets_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@null" />
                    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <ImageView android:id="@+id/wb_eq_on" android:layout_width="46dp" android:layout_height="20dp" android:contentDescription="EQ on / off" android:scaleType="center" />
                </LinearLayout>
                <LinearLayout style="@style/WbRow"><ImageView android:id="@+id/wb_p0" style="@style/WbChip" /><ImageView android:id="@+id/wb_p1" style="@style/WbChip" /></LinearLayout>
                <LinearLayout style="@style/WbRow"><ImageView android:id="@+id/wb_p2" style="@style/WbChip" /><ImageView android:id="@+id/wb_p3" style="@style/WbChip" /></LinearLayout>
                <LinearLayout style="@style/WbRow"><ImageView android:id="@+id/wb_p4" style="@style/WbChip" /><ImageView android:id="@+id/wb_p5" style="@style/WbChip" /></LinearLayout>
                <LinearLayout style="@style/WbRow"><ImageView android:id="@+id/wb_p6" style="@style/WbChip" /><ImageView android:id="@+id/wb_p7" style="@style/WbChip" /></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ═══ Options drawer: 168 dp, same inner area ═══ -->
    <FrameLayout
        android:id="@+id/wb_drawer_controls"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:visibility="gone">

        <ImageView android:id="@+id/wb_drawer_controls_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/wb_card"
            android:orientation="vertical"
            android:padding="10dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.9">
                <ImageView android:id="@+id/wb_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3" android:orientation="horizontal">
                <ImageView android:id="@+id/wb_back10" style="@style/WbPill" />
                <ImageView android:id="@+id/wb_fwd10" style="@style/WbPill" />
                <ImageView android:id="@+id/wb_restart" style="@style/WbPill" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3" android:layout_marginTop="6dp" android:orientation="horizontal">
                <ImageView android:id="@+id/wb_stop" style="@style/WbPill" />
                <ImageView android:id="@+id/wb_handoff" style="@style/WbPill" android:layout_weight="1.6" android:background="@drawable/wb_chip_smart" />
                <ImageView android:id="@+id/wb_open" style="@style/WbPill" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

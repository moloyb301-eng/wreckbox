<?xml version="1.0" encoding="utf-8"?>
<!-- The player widget: chrome body (jog disc + LCD + transport + drawer tabs) and one drawer under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/wb_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <!-- Jog disc with play / pause -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/wb_disc">

            <ImageView
                android:id="@+id/wb_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/wb_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@drawable/wb_play"
                android:contentDescription="Play / pause"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wb_ic_play" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- LCD -->
            <LinearLayout
                android:id="@+id/wb_lcd"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/wb_lcd"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/wb_art"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <!-- Title (dot-matrix) + artist, drawn by PlayerWidget: widgets can't use an app's own font. -->
                <ImageView
                    android:id="@+id/wb_titleimg"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitStart" />

                <!-- Clock + status, on the right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <Chronometer
                        android:id="@+id/wb_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#FFEFAF86"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wb_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="STOP"
                        android:textColor="#80FFFFFF"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Transport + drawer tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton android:id="@+id/wb_prev" android:layout_width="38dp" android:layout_height="28dp" android:background="@drawable/wb_pill" android:contentDescription="Previous" android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/wb_ic_prev" />
                <ImageButton android:id="@+id/wb_stop" android:layout_width="38dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:background="@drawable/wb_pill" android:contentDescription="Stop" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/wb_ic_stop" />
                <ImageButton android:id="@+id/wb_next" android:layout_width="38dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:background="@drawable/wb_pill" android:contentDescription="Next" android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/wb_ic_next" />

                <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton android:id="@+id/wb_tab_controls" android:layout_width="38dp" android:layout_height="28dp" android:background="@drawable/wb_pill" android:contentDescription="Controls drawer" android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/wb_ic_list" />
                <ImageButton android:id="@+id/wb_tab_eq" android:layout_width="38dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:background="@drawable/wb_pill" android:contentDescription="EQ drawer" android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/wb_ic_eq" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Controls drawer -->
    <LinearLayout
        android:id="@+id/wb_drawer_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/wb_tray"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/wb_lcd" android:orientation="vertical" android:padding="8dp">
            <ProgressBar
                android:id="@+id/wb_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="1000"
                android:progressTint="#FFBB96DA"
                android:progressBackgroundTint="#33FFFFFF" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/wb_back10" style="@style/WbKey" android:text="−10S" />
                <Button android:id="@+id/wb_fwd10" style="@style/WbKey" android:text="+10S" />
                <Button android:id="@+id/wb_voldown" style="@style/WbKey" android:text="VOL−" />
                <Button android:id="@+id/wb_volup" style="@style/WbKey" android:text="VOL+" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="6dp" android:orientation="horizontal">
                <Button android:id="@+id/wb_handoff" style="@style/WbKey" android:layout_weight="2" android:text="PLAY ON MAC" />
                <Button android:id="@+id/wb_open" style="@style/WbKey" android:text="APP" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- EQ drawer -->
    <LinearLayout
        android:id="@+id/wb_drawer_eq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/wb_tray"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/wb_lcd" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/wb_eq_curve" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:contentDescription="@null" android:scaleType="fitXY" />
                <Button android:id="@+id/wb_eq_on" style="@style/WbKey" android:layout_width="56dp" android:layout_weight="0" android:layout_marginStart="8dp" android:text="EQ ON" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/wb_p0" style="@style/WbKey" android:text="FLAT" />
                <Button android:id="@+id/wb_p1" style="@style/WbKey" android:text="BASS" />
                <Button android:id="@+id/wb_p2" style="@style/WbKey" android:text="CLUB" />
                <Button android:id="@+id/wb_p3" style="@style/WbKey" android:text="HIPHOP" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="5dp" android:orientation="horizontal">
                <Button android:id="@+id/wb_p4" style="@style/WbKey" android:text="ELECTRO" />
                <Button android:id="@+id/wb_p5" style="@style/WbKey" android:text="VOCAL" />
                <Button android:id="@+id/wb_p6" style="@style/WbKey" android:text="TREBLE" />
                <Button android:id="@+id/wb_p7" style="@style/WbKey" android:text="LOUD" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

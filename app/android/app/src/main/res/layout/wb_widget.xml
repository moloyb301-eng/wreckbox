<?xml version="1.0" encoding="utf-8"?>
<!-- WreckBox widget, Y2K style (Sonique look, Winamp functions). The casing, the LCD and the EQ screen are bitmaps
     drawn by PlayerWidget at the widget's real size from the same dp measurements used here (see Geo in
     PlayerWidget.kt), so the controls sit exactly in their wells. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ═══ Body ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="186dp">

        <ImageView android:id="@+id/wb_body_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />

        <!-- LCD: left 16, top 34, right 116, height 104 -->
        <ImageView
            android:id="@+id/wb_lcd"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="34dp"
            android:layout_marginEnd="116dp"
            android:contentDescription="Open WreckBox"
            android:scaleType="fitXY" />

        <!-- The clock runs by itself (no updates needed): top-left of the LCD -->
        <ImageView
            android:id="@+id/wb_clock"
            android:layout_width="130dp"
            android:layout_height="30dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="36dp"
            android:contentDescription="@null"
            android:scaleType="fitStart" />

        <!-- Seek bar: left 18, top 146, right 118 -->
        <ProgressBar
            android:id="@+id/wb_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="146dp"
            android:layout_marginEnd="118dp"
            android:max="1000"
            android:progressDrawable="@drawable/wb_seek" />

        <!-- Winamp tabs on the bottom edge: left 22, top 160 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="160dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/wb_tab_eq" style="@style/WbTab" android:layout_width="96dp"  android:contentDescription="@null" android:scaleType="center" />
            <ImageView android:id="@+id/wb_tab_controls" style="@style/WbTab" android:layout_width="84dp" android:layout_marginStart="6dp"  android:contentDescription="@null" android:scaleType="center" />
        </LinearLayout>

        <!-- Candy buttons in the pod on the right: 92 wide, 12 from the edge, top 32 -->
        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageButton android:id="@+id/wb_prev" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/wb_btn_blue" android:contentDescription="Previous" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/wb_icw_prev" />
                <ImageButton android:id="@+id/wb_next" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="14dp" android:background="@drawable/wb_btn_blue" android:contentDescription="Next" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/wb_icw_next" />
            </LinearLayout>

            <ImageButton android:id="@+id/wb_play" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginTop="5dp" android:background="@drawable/wb_btn_green" android:contentDescription="Play / pause" android:padding="15dp" android:scaleType="fitCenter" android:src="@drawable/wb_icw_play" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/wb_voldown" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/wb_btn_yellow" android:contentDescription="Volume down" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/wb_icw_minus" />
                <ImageButton android:id="@+id/wb_stop" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="5dp" android:background="@drawable/wb_btn_orange" android:contentDescription="Stop" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/wb_icw_stop" />
                <ImageButton android:id="@+id/wb_volup" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="5dp" android:background="@drawable/wb_btn_yellow" android:contentDescription="Volume up" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/wb_icw_plus" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ═══ Equalizer drawer ═══ -->
    <FrameLayout
        android:id="@+id/wb_drawer_eq"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:visibility="gone">

        <ImageView android:id="@+id/wb_drawer_eq_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />

        <!-- Inner area: 16 from the sides, 12 from the top, 22 from the bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/wb_eq_curve" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="11" android:contentDescription="@null" android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="10"
                android:background="@drawable/wb_screen"
                android:orientation="vertical"
                android:padding="5dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/wb_presets_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" android:scaleType="fitStart" android:paddingStart="4dp" />
                    <ImageView android:id="@+id/wb_eq_on" style="@style/WbLed" android:layout_width="54dp" android:layout_height="18dp" android:layout_weight="0"  android:contentDescription="@null" android:scaleType="center" />
                </LinearLayout>
                <LinearLayout style="@style/WbRow"><ImageView android:id="@+id/wb_p0" style="@style/WbPreset"  android:contentDescription="@null" android:scaleType="center" /><ImageView android:id="@+id/wb_p1" style="@style/WbPreset"  android:contentDescription="@null" android:scaleType="center" /></LinearLayout>
                <LinearLayout style="@style/WbRow"><ImageView android:id="@+id/wb_p2" style="@style/WbPreset"  android:contentDescription="@null" android:scaleType="center" /><ImageView android:id="@+id/wb_p3" style="@style/WbPreset"  android:contentDescription="@null" android:scaleType="center" /></LinearLayout>
                <LinearLayout style="@style/WbRow"><ImageView android:id="@+id/wb_p4" style="@style/WbPreset"  android:contentDescription="@null" android:scaleType="center" /><ImageView android:id="@+id/wb_p5" style="@style/WbPreset"  android:contentDescription="@null" android:scaleType="center" /></LinearLayout>
                <LinearLayout style="@style/WbRow"><ImageView android:id="@+id/wb_p6" style="@style/WbPreset"  android:contentDescription="@null" android:scaleType="center" /><ImageView android:id="@+id/wb_p7" style="@style/WbPreset"  android:contentDescription="@null" android:scaleType="center" /></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ═══ Options drawer ═══ -->
    <FrameLayout
        android:id="@+id/wb_drawer_controls"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:visibility="gone">

        <ImageView android:id="@+id/wb_drawer_controls_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/wb_screen"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView android:id="@+id/wb_info" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@null" android:paddingStart="4dp" android:scaleType="fitStart" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3" android:orientation="horizontal">
                <ImageView android:id="@+id/wb_back10" style="@style/WbLed"  android:contentDescription="@null" android:scaleType="center" />
                <ImageView android:id="@+id/wb_fwd10" style="@style/WbLed"  android:contentDescription="@null" android:scaleType="center" />
                <ImageView android:id="@+id/wb_restart" style="@style/WbLed"  android:contentDescription="@null" android:scaleType="center" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3" android:layout_marginTop="5dp" android:orientation="horizontal">
                <ImageView android:id="@+id/wb_handoff" style="@style/WbLed" android:layout_weight="2"  android:contentDescription="@null" android:scaleType="center" />
                <ImageView android:id="@+id/wb_open" style="@style/WbLed"  android:contentDescription="@null" android:scaleType="center" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

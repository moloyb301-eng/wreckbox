<?xml version="1.0" encoding="utf-8"?>
<!-- WreckBox player widget: 4×3 by default (the bottom row is where the drawers open). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="280dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="280dp"
    android:minResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/wb_widget"
    android:previewLayout="@layout/wb_widget"
    android:description="@string/wb_widget_description"
    android:widgetCategory="home_screen" />

<?xml version="1.0" encoding="utf-8"?>
<!-- Invisible touch target over a dial segment; a soft glow while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#2EFFFFFF" /></shape></item>
    <item android:drawable="@android:color/transparent" />
</selector>

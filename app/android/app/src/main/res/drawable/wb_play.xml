<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#FF6E7178" android:endColor="#FFCDD0D5" />
            <stroke android:width="1.5dp" android:color="#FF3E4046" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:centerColor="#FFB9BCC2" android:endColor="#FFECEDF0" />
            <stroke android:width="1.5dp" android:color="#FF6A6D74" />
        </shape>
    </item>
</selector>

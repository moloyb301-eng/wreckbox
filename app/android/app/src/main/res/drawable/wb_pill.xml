<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#FF3A3C42" android:endColor="#FF18191C" />
            <stroke android:width="1dp" android:color="#FF111214" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#FFFAFAFB" android:centerColor="#FFB5B8BF" android:endColor="#FFE2E3E7" />
            <stroke android:width="1dp" android:color="#FF6A6D74" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- A tab with no drawer open: a complete little key hanging off the body (rounded all round, bevelled). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:topLeftRadius="6dp" android:topRightRadius="6dp" android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" /><solid android:color="#FF1A1820" /><stroke android:width="1dp" android:color="#66BB96DA" /></shape></item>
    <item>
        <layer-list>
            <item><shape><corners android:topLeftRadius="6dp" android:topRightRadius="6dp" android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" /><solid android:color="#FF07060A" /></shape></item>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1.5dp"><shape><corners android:topLeftRadius="5dp" android:topRightRadius="5dp" android:bottomLeftRadius="11dp" android:bottomRightRadius="11dp" /><gradient android:angle="270" android:startColor="#FF3A3645" android:endColor="#FF1C1A23" /></shape></item>
            <item android:top="1dp" android:left="8dp" android:right="8dp" android:bottom="26dp"><shape><solid android:color="#40FFFFFF" /></shape></item>
            <item android:top="25.5dp" android:left="12dp" android:right="12dp" android:bottom="1.5dp"><shape><solid android:color="#59BB96DA" /></shape></item>
        </layer-list>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- A bevelled tab hanging off the body. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:topLeftRadius="10dp" android:topRightRadius="10dp" /><solid android:color="#FF1A1820" /></shape></item>
    <item>
        <layer-list>
            <item><shape><corners android:topLeftRadius="10dp" android:topRightRadius="10dp" /><solid android:color="#FF07060A" /></shape></item>
            <item android:top="1dp" android:left="1dp" android:right="1dp"><shape><corners android:topLeftRadius="9dp" android:topRightRadius="9dp" /><gradient android:angle="270" android:startColor="#FF3A3645" android:endColor="#FF1C1A23" /></shape></item>
            <item android:top="1dp" android:left="8dp" android:right="8dp" android:bottom="26dp"><shape><solid android:color="#40FFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>

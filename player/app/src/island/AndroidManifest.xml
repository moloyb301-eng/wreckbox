<?xml version="1.0" encoding="utf-8"?>
<!-- Only in -PwbIsland builds (the user's own phone, installed over USB). The downloadable build leaves it out: Play
     Protect's fraud protection blocks installing any downloaded app that declares an accessibility service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The island round the camera (Island.kt): an accessibility service only so it can draw above the status bar -->
        <service
            android:name=".IslandService"
            android:exported="true"
            android:label="@string/island_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/island_accessibility" />
        </service>
    </application>
</manifest>
